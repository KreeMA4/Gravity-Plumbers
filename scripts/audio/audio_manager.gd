extends Node
## AudioManager (autoload)
## -----------------------------------------------------------------------------
## - Creates the Master / Music / SFX / Voice buses in code (no .tres to break).
## - Plays sounds by short name from res://assets/audio/<name>.wav
##   (generated by tools/make_audio.py). Missing files are skipped quietly.
## - Pools AudioStreamPlayer3D voices (cap = Tuning.MAX_VOICES) and rate-limits
##   repeats so a pile of impacts doesn't machine-gun.
## - Music: a gameplay groove plus a "storm" stem that crossfades in during
##   gravity storms, and a calm menu theme.
## - Gibberish blip voice for DISPATCH-O-TRON and plumbers.

const AUDIO_DIR: String = "res://assets/audio/"
const BUSES: Array = ["Music", "SFX", "Voice"]

var _streams: Dictionary = {}       ## name -> AudioStream (or null if missing)
var _pool3d: Array = []             ## Array of AudioStreamPlayer3D
var _pool_ui: Array = []            ## Array of AudioStreamPlayer
var _last_played: Dictionary = {}   ## name -> msec, for rate limiting
var _music_a: AudioStreamPlayer
var _music_storm: AudioStreamPlayer
var _music_name: String = ""
var _storm_target: float = 0.0
var _storm_level: float = 0.0
var _voice_queue: Array = []        ## pending blips: [time, pitch, volume, pos or null]
var _voice_time: float = 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()
	for i: int in Tuning.MAX_VOICES:
		var p: AudioStreamPlayer3D = AudioStreamPlayer3D.new()
		p.bus = "SFX"
		p.unit_size = 6.0
		p.max_distance = 40.0
		add_child(p)
		_pool3d.append(p)
	for i: int in 8:
		var u: AudioStreamPlayer = AudioStreamPlayer.new()
		u.bus = "SFX"
		add_child(u)
		_pool_ui.append(u)
	_music_a = AudioStreamPlayer.new()
	_music_a.bus = "Music"
	add_child(_music_a)
	_music_storm = AudioStreamPlayer.new()
	_music_storm.bus = "Music"
	_music_storm.volume_db = -60.0
	add_child(_music_storm)
	apply_volumes()
	SaveData.settings_changed.connect(apply_volumes)
	GravityManager.shift_warning.connect(_on_shift_warning)
	GravityManager.shift_started.connect(_on_shift_started)
	GravityManager.shift_finished.connect(_on_shift_finished)


func _setup_buses() -> void:
	for bus_name: String in BUSES:
		if AudioServer.get_bus_index(bus_name) == -1:
			AudioServer.add_bus()
			var idx: int = AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, bus_name)
			AudioServer.set_bus_send(idx, "Master")


func apply_volumes() -> void:
	_set_bus_volume("Master", SaveData.setting_f("vol_master"))
	_set_bus_volume("Music", SaveData.setting_f("vol_music"))
	_set_bus_volume("SFX", SaveData.setting_f("vol_sfx"))
	_set_bus_volume("Voice", SaveData.setting_f("vol_voice"))


func _set_bus_volume(bus_name: String, linear: float) -> void:
	var idx: int = AudioServer.get_bus_index(bus_name)
	if idx < 0:
		return
	var v: float = clampf(linear, 0.0, 1.0)
	AudioServer.set_bus_mute(idx, v <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(v, 0.001)))


## Load (and cache) a sound by name. Returns null if the file doesn't exist.
func get_stream(sound_name: String) -> AudioStream:
	if _streams.has(sound_name):
		return _streams[sound_name] as AudioStream
	var path: String = AUDIO_DIR + sound_name + ".wav"
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path) as AudioStream
	_streams[sound_name] = s
	return s


func _rate_ok(sound_name: String) -> bool:
	var now: int = Time.get_ticks_msec()
	var last: int = int(_last_played.get(sound_name, -100000))
	if float(now - last) < Tuning.SAME_SOUND_COOLDOWN * 1000.0:
		return false
	_last_played[sound_name] = now
	return true


## Non-positional sound (UI clicks, jingles).
func play_ui(sound_name: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var s: AudioStream = get_stream(sound_name)
	if s == null or not _rate_ok(sound_name):
		return
	for item: Variant in _pool_ui:
		var p: AudioStreamPlayer = item as AudioStreamPlayer
		if not p.playing:
			p.stream = s
			p.volume_db = volume_db
			p.pitch_scale = pitch
			p.play()
			return


## Positional sound at a world position. pitch_var adds random pitch variety.
func play_at(sound_name: String, pos: Vector3, volume_db: float = 0.0, pitch: float = 1.0, pitch_var: float = 0.08) -> void:
	var s: AudioStream = get_stream(sound_name)
	if s == null or not _rate_ok(sound_name) or not pos.is_finite():
		return
	var chosen: AudioStreamPlayer3D = null
	for item: Variant in _pool3d:
		var p: AudioStreamPlayer3D = item as AudioStreamPlayer3D
		if not p.playing:
			chosen = p
			break
	if chosen == null:
		return   # voice cap reached: drop the sound rather than cut another
	chosen.stream = s
	chosen.global_position = pos
	chosen.volume_db = volume_db
	chosen.pitch_scale = maxf(0.3, pitch + randf_range(-pitch_var, pitch_var))
	chosen.bus = "Voice" if sound_name.begins_with("blip") else "SFX"
	chosen.play()


# --- Music -------------------------------------------------------------------

## track: "menu", "game" or "" (stop).
func play_music(track: String) -> void:
	if track == _music_name:
		return
	_music_name = track
	_music_a.stop()
	_music_storm.stop()
	if track == "":
		return
	var main: AudioStream = get_stream("music_" + track)
	if main != null:
		_music_a.stream = main
		_music_a.volume_db = -6.0
		_music_a.play()
	if track == "game":
		var storm: AudioStream = get_stream("music_storm")
		if storm != null:
			_music_storm.stream = storm
			_music_storm.volume_db = -60.0
			_music_storm.play()


func _on_shift_warning(_dir: Vector3, _t: float) -> void:
	_storm_target = 1.0
	play_ui("gravity_siren", -2.0)


func _on_shift_started(_dir: Vector3) -> void:
	play_ui("gravity_whoomp", 0.0)


func _on_shift_finished(_dir: Vector3) -> void:
	_storm_target = 0.0


# --- Blip voice --------------------------------------------------------------

## Speak `text` as gibberish blips. base_pitch ~1.0. pos = null for non-positional.
func speak(text: String, base_pitch: float = 1.0, pos: Variant = null) -> void:
	var t: float = 0.0
	var count: int = 0
	for i: int in text.length():
		var c: int = text.unicode_at(i)
		if c == 32 or c == 44 or c == 46 or c == 33 or c == 63:
			t += 0.06
			continue
		if i % 2 == 1:
			continue  # one blip per two letters keeps it snappy
		var semis: float = float((c * 7) % 9) - 4.0
		var pitch: float = base_pitch * pow(2.0, semis / 12.0)
		_voice_queue.append([_voice_time + t, pitch, pos])
		t += 0.075
		count += 1
		if count > 40:
			break


func _process(delta: float) -> void:
	# Storm music crossfade.
	_storm_level = move_toward(_storm_level, _storm_target, delta * 0.8)
	if _music_storm.playing:
		_music_storm.volume_db = linear_to_db(maxf(0.001, _storm_level)) - 4.0
	# Blip voice queue.
	_voice_time += delta
	while _voice_queue.size() > 0 and float((_voice_queue[0] as Array)[0]) <= _voice_time:
		var b: Array = _voice_queue.pop_front()
		var pitch: float = float(b[1])
		var s: AudioStream = get_stream("blip")
		if s == null:
			continue
		if b[2] is Vector3:
			_last_played.erase("blip")
			play_at("blip", b[2] as Vector3, -4.0, pitch, 0.0)
		else:
			_last_played.erase("blip")
			play_ui("blip", -6.0, pitch)
	if _voice_queue.is_empty():
		_voice_time = 0.0
